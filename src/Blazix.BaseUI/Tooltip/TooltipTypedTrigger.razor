@using Blazix.BaseUI.Popover
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@typeparam TPayload
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<RenderElement TState="TooltipTriggerState"
               Tag="button"
               Enabled="RootContext is not null || HasHandle"
               State="ResolveState()"
               Render="Render"
               ClassValue="ClassValue"
               StyleValue="StyleValue"
               ComponentAttributes="BuildComponentAttributes()"
               ChildContent="ChildContent"
               @attributes="AdditionalAttributes"
               @ref="renderElementReference" />

@code {
    // lint-ignore:RULE-05 React Base UI parity requires this exact attribute name.
    private const string TooltipTriggerIdentifier = "data-base-ui-tooltip-trigger";

    private Lazy<Task<IJSObjectReference>>? moduleTask;
    private bool hoverInitialized;
    private string? hoverRootId;
    private Task hoverRebindTask = Task.CompletedTask;
    private bool hasRendered;
    private string triggerId = null!;
    private TooltipHandle<TPayload>? registeredHandle;
    private TooltipHandle<TPayload>? subscribedHandleRootHoverState;
    private RenderElement<TooltipTriggerState>? renderElementReference;
    private ElementReference? previousElement;
    private int lastEffectiveDelay = -1;
    private int lastEffectiveCloseDelay = -1;
    private bool? lastDisableHoverablePopup;
    private bool recentPointerDown;
    private bool blockFocusOpen;
    private bool wasOpen;
    private bool lastIsDisabled;
    private TooltipRootContext? subscribedRootContext;

    private Lazy<Task<IJSObjectReference>> ModuleTask => moduleTask ??= new Lazy<Task<IJSObjectReference>>(() =>
        JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Blazix.BaseUI/blazix-baseui-tooltip.min.js").AsTask());

    private bool HasHandle => Handle is not null;

    private bool HasRootContext => RootContext is not null;

    private bool IsDisabled => Disabled || (RootContext?.Disabled ?? false);

    [CascadingParameter]
    private TooltipRootContext? RootContext { get; set; }

    [CascadingParameter]
    private TooltipProviderContext? ProviderContext { get; set; }

    /// <summary>
    /// Gets or sets a custom render template for the trigger element.
    /// </summary>
    [Parameter]
    public RenderFragment<RenderProps<TooltipTriggerState>>? Render { get; set; }

    /// <summary>
    /// Determines whether the trigger is currently disabled.
    /// Defaults to <see langword="false"/>.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the delay in milliseconds before the tooltip opens on hover.
    /// When <see langword="null"/>, falls back to the provider delay or <c>600</c>.
    /// Defaults to <see langword="null"/>.
    /// </summary>
    [Parameter]
    public int? Delay { get; set; }

    /// <summary>
    /// Gets or sets the delay in milliseconds before the tooltip closes after the cursor leaves.
    /// Defaults to <see langword="null"/>.
    /// </summary>
    [Parameter]
    public int? CloseDelay { get; set; }

    /// <summary>
    /// Gets or sets the ID of the trigger. In addition to being forwarded to the rendered element,
    /// it is also used to specify the active trigger for the tooltip in controlled mode.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the handle to associate the trigger with a tooltip.
    /// </summary>
    [Parameter]
    public TooltipHandle<TPayload>? Handle { get; set; }

    /// <summary>
    /// Gets or sets the payload to pass to the tooltip when it is opened by this trigger.
    /// </summary>
    [Parameter]
    public TPayload? Payload { get; set; }

    /// <summary>
    /// Gets or sets a function that returns CSS class names based on the current state.
    /// </summary>
    [Parameter]
    public Func<TooltipTriggerState, string>? ClassValue { get; set; }

    /// <summary>
    /// Gets or sets a function that returns inline styles based on the current state.
    /// </summary>
    [Parameter]
    public Func<TooltipTriggerState, string>? StyleValue { get; set; }

    /// <summary>
    /// Defines the child components of this instance.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets a collection of additional attributes that will be applied to the created element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets or sets the associated <see cref="ElementReference"/>.
    /// </summary>
    public ElementReference? Element => renderElementReference?.Element;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        triggerId = Id ?? Guid.NewGuid().ToIdString();
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(RootContext, subscribedRootContext))
        {
            if (subscribedRootContext is not null)
            {
                subscribedRootContext.StateChanged -= HandleRootContextStateChanged;
            }

            subscribedRootContext = RootContext;
            if (subscribedRootContext is not null)
            {
                subscribedRootContext.StateChanged += HandleRootContextStateChanged;
            }
        }

        var triggerIdChanged = false;

        if (Id is not null && Id != triggerId)
        {
            var previousTriggerId = triggerId;
            UnregisterFromCurrentStore(previousTriggerId);
            triggerId = Id;
            triggerIdChanged = true;

            if (hoverInitialized)
            {
                QueueHoverRebind(previousTriggerId, triggerId);
            }
        }

        // Handle change of handle parameter
        if (Handle != registeredHandle)
        {
            if (!triggerIdChanged)
            {
                registeredHandle?.UnregisterTrigger(triggerId);
            }

            if (subscribedHandleRootHoverState is not null)
            {
                subscribedHandleRootHoverState.RootHoverStateChanged -= HandleRootHoverStateChanged;
            }

            registeredHandle = Handle;
            subscribedHandleRootHoverState = Handle;
            if (subscribedHandleRootHoverState is not null)
            {
                subscribedHandleRootHoverState.RootHoverStateChanged += HandleRootHoverStateChanged;
            }

            RegisterWithCurrentStore();
        }
        else if (triggerIdChanged)
        {
            RegisterWithCurrentStore();
        }
        else if (HasHandle)
        {
            // Update payload on existing handle
            Handle!.UpdateTriggerPayload(triggerId, Payload);
        }

        var previousOpen = wasOpen;
        var open = IsOpenedByThisTrigger();

        if (previousOpen && !open)
        {
            var reason = HasHandle ? (TooltipOpenChangeReason?)null : RootContext?.OpenChangeReason;
            if (reason is TooltipOpenChangeReason.EscapeKey
                or TooltipOpenChangeReason.OutsidePress
                or TooltipOpenChangeReason.TriggerPress)
            {
                blockFocusOpen = true;
            }
        }

        // Update payload via context if not using handle
        if (!HasHandle)
        {
            RootContext?.SetTriggerPayload(triggerId, Payload);
        }

        var effectiveDisabled = IsDisabled;

        // Handle disabled-state changes
        if (effectiveDisabled != lastIsDisabled)
        {
            if (!hoverInitialized && CanInitializeHoverInteraction())
            {
                _ = InitializeHoverInteractionAsync();
            }
            else if (effectiveDisabled && hoverInitialized)
            {
                _ = DisposeHoverInteractionAsync();
            }

            lastIsDisabled = effectiveDisabled;
        }
        // Re-initialize JS hover if effective delays changed
        else if (hoverInitialized && CanInitializeHoverInteraction())
        {
            // Upstream recomputes `handleClose` on every render from the live
            // `disableHoverablePopup`/`trackCursorAxis` values, so re-arm safePolygon when they change.
            if (ResolveDisableHoverablePopup() != lastDisableHoverablePopup)
            {
                QueueHoverReinitialize();
            }
            else
            {
                var effectiveDelay = GetEffectiveDelay();
                var effectiveCloseDelay = GetEffectiveCloseDelay();
                if (effectiveDelay != lastEffectiveDelay || effectiveCloseDelay != lastEffectiveCloseDelay)
                {
                    _ = UpdateHoverInteractionDelaysAsync();
                }
            }
        }

        wasOpen = open;
    }

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            hasRendered = true;

            if (HasHandle)
            {
                Handle!.RegisterTrigger(triggerId, Element, Payload);
                registeredHandle = Handle;
            }
            else
            {
                RootContext?.RegisterTriggerElement(triggerId, Element);
            }

            if (!hoverInitialized && CanInitializeHoverInteraction())
            {
                _ = InitializeHoverInteractionAsync();
            }
        }

        var currentElement = Element;
        if (!Nullable.Equals(previousElement, currentElement))
        {
            previousElement = currentElement;
            OnElementChanged();
        }
    }

    private TooltipTriggerState ResolveState()
    {
        return new TooltipTriggerState(IsOpenedByThisTrigger(), IsDisabled);
    }

    private Dictionary<string, object> BuildComponentAttributes()
    {
        var attrs = new Dictionary<string, object>();

        attrs["type"] = "button";

        if (IsDisabled)
        {
            // lint-ignore:RULE-06 React Base UI parity requires this empty marker attribute.
            attrs["data-trigger-disabled"] = "";
        }

        if (!IsDisabled)
        {
            // lint-ignore:RULE-06 React Base UI parity requires this empty marker attribute.
            attrs[TooltipTriggerIdentifier] = "";
        }

        var open = IsOpenedByThisTrigger();
        var popupId = RootContext?.PopupId;

        if (open && popupId is not null)
        {
            attrs["aria-describedby"] = popupId;
        }

        attrs["id"] = triggerId;

        if (open)
        {
            // lint-ignore:RULE-06 React Base UI parity requires this empty marker attribute.
            attrs["data-popup-open"] = "";
        }

        // No `onmouseenter`/`onmouseleave` handlers: hover is owned entirely by the JS
        // interaction, so a C# handler would only cost an interop round trip per hover in and
        // out. A consumer's own handlers still reach the element through AdditionalAttributes,
        // which RenderElement merges before these component attributes.
        attrs["onpointerdown"] = EventCallback.Factory.Create<PointerEventArgs>(this, HandlePointerDownAsync);
        attrs["onclick"] = EventCallback.Factory.Create<MouseEventArgs>(this, HandleClickAsync);
        attrs["onfocus"] = EventCallback.Factory.Create<FocusEventArgs>(this, HandleFocusAsync);
        attrs["onblur"] = EventCallback.Factory.Create<FocusEventArgs>(this, HandleBlurAsync);

        return attrs;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        UnregisterFromCurrentStore(triggerId);

        if (subscribedRootContext is not null)
        {
            subscribedRootContext.StateChanged -= HandleRootContextStateChanged;
            subscribedRootContext = null;
        }

        if (subscribedHandleRootHoverState is not null)
        {
            subscribedHandleRootHoverState.RootHoverStateChanged -= HandleRootHoverStateChanged;
            subscribedHandleRootHoverState = null;
        }

        await DisposeHoverInteractionAsync();

        if (moduleTask?.IsValueCreated == true)
        {
            try
            {
                var module = await moduleTask.Value;
                await module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
            {
                _ = ex; // Expected during circuit disconnect - safe to ignore.
            }
        }
    }

    private void OnElementChanged()
    {
        if (HasHandle)
        {
            Handle!.UpdateTriggerElement(triggerId, Element);
        }
        else
        {
            RootContext?.RegisterTriggerElement(triggerId, Element);
        }
    }

    private void RegisterWithCurrentStore()
    {
        if (HasHandle)
        {
            Handle!.RegisterTrigger(triggerId, Element, Payload);
        }
        else
        {
            RootContext?.RegisterTriggerElement(triggerId, Element);
            RootContext?.SetTriggerPayload(triggerId, Payload);
        }
    }

    private void HandleRootContextStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (hoverInitialized && CanInitializeHoverInteraction())
                {
                    await UpdateHoverInteractionDelaysAsync();
                }
            }
            finally
            {
                StateHasChanged();
            }
        });
    }

    // A detached trigger learns its root ID only once the handle-backed root has subscribed,
    // which can happen after this trigger's first render.
    private void HandleRootHoverStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (!hoverInitialized && CanInitializeHoverInteraction())
                {
                    await InitializeHoverInteractionAsync();
                }
                else if (hoverInitialized
                    && CanInitializeHoverInteraction()
                    && ResolveDisableHoverablePopup() != lastDisableHoverablePopup)
                {
                    QueueHoverReinitialize();
                }
            }
            finally
            {
                StateHasChanged();
            }
        });
    }

    private void UnregisterFromCurrentStore(string id)
    {
        if (registeredHandle is not null)
        {
            registeredHandle.UnregisterTrigger(id);
        }
        else
        {
            RootContext?.UnregisterTriggerElement(id);
        }
    }

    private bool IsOpenedByThisTrigger()
    {
        // Check handle state first if using detached trigger pattern
        if (HasHandle)
        {
            var isOpen = Handle!.IsOpen;
            if (!isOpen)
            {
                return false;
            }
            var activeId = Handle.ActiveTriggerId;
            return activeId == triggerId || (activeId is null && isOpen);
        }

        // Fall back to root context
        if (RootContext is null)
        {
            return false;
        }

        var rootOpen = RootContext.GetOpen();
        if (!rootOpen)
        {
            return false;
        }

        var activeTriggerId = RootContext.ActiveTriggerId;
        return activeTriggerId == triggerId || (activeTriggerId is null && rootOpen);
    }

    private int GetEffectiveDelay()
    {
        if (IsAnyTooltipOpen())
        {
            return 0;
        }

        if (RootContext?.IsDelayGroupInstantPhase == true)
        {
            return 0;
        }

        if (ProviderContext?.IsInInstantPhase() == true)
        {
            return 0;
        }

        return Delay ?? ProviderContext?.Delay ?? 600;
    }

    private int GetEffectiveCloseDelay()
    {
        return CloseDelay ?? ProviderContext?.CloseDelay ?? 0;
    }

    private async Task HandlePointerDownAsync(PointerEventArgs e)
    {
        recentPointerDown = true;

        // Upstream wires `closeOnReferencePress` to both `onPointerDown` and `onClick`
        // (useDismiss.ts reference props), so a press dismisses before `mouseup`.
        if (!IsDisabled && CloseOnClick && IsOpenedByThisTrigger())
        {
            blockFocusOpen = true;
            await RequestOpenAsync(false, TooltipOpenChangeReason.TriggerPress);
        }
        else if (CloseOnClick && !IsOpenedByThisTrigger())
        {
            var hoverRootIdForCancel = GetHoverRootId();
            if (hoverInitialized && !string.IsNullOrEmpty(hoverRootIdForCancel) && moduleTask?.IsValueCreated == true)
            {
                try
                {
                    var module = await moduleTask.Value;
                    await module.InvokeVoidAsync("cancelPendingHoverOpen", hoverRootIdForCancel, triggerId);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
                {
                    _ = ex; // Expected during circuit disconnect - safe to ignore.
                }
            }
        }

        await EventUtilities.InvokeOnPointerDownAsync(AdditionalAttributes, e);
    }

    private async Task HandleFocusAsync(FocusEventArgs e)
    {
        if (recentPointerDown)
        {
            recentPointerDown = false;
            await EventUtilities.InvokeOnFocusAsync(AdditionalAttributes, e);
            return;
        }

        if (blockFocusOpen)
        {
            await EventUtilities.InvokeOnFocusAsync(AdditionalAttributes, e);
            return;
        }

        if (!HasRootContext && !HasHandle)
        {
            await EventUtilities.InvokeOnFocusAsync(AdditionalAttributes, e);
            return;
        }

        // Upstream creates the focus interaction with `enabled: !disabled`, so a disabled
        // trigger installs no handlers and never closes another trigger's open tooltip.
        if (IsDisabled)
        {
            await EventUtilities.InvokeOnFocusAsync(AdditionalAttributes, e);
            return;
        }

        if (IsOpenedByThisTrigger())
        {
            return;
        }

        await RequestOpenAsync(true, TooltipOpenChangeReason.TriggerFocus);
        await EventUtilities.InvokeOnFocusAsync(AdditionalAttributes, e);
    }

    private async Task HandleBlurAsync(FocusEventArgs e)
    {
        blockFocusOpen = false;

        if (IsDisabled || (!HasRootContext && !HasHandle))
        {
            await EventUtilities.InvokeOnBlurAsync(AdditionalAttributes, e);
            return;
        }

        if (!IsOpenedByThisTrigger())
        {
            return;
        }

        await RequestOpenAsync(false, TooltipOpenChangeReason.TriggerFocus);
        await EventUtilities.InvokeOnBlurAsync(AdditionalAttributes, e);
    }

    private async Task HandleClickAsync(MouseEventArgs e)
    {
        recentPointerDown = false;

        if (!IsDisabled && CloseOnClick && IsOpenedByThisTrigger())
        {
            blockFocusOpen = true;
            await RequestOpenAsync(false, TooltipOpenChangeReason.TriggerPress);
        }

        await EventUtilities.InvokeOnClickAsync(AdditionalAttributes, e);
    }

    // Upstream builds the hover interaction from `handleStore ?? rootContext`
    // (TooltipTrigger.tsx), so a detached handle-backed trigger installs the same safePolygon,
    // mouseOnly and hoverable-popup behaviour as one nested inside a Tooltip.Root.
    private bool CanInitializeHoverInteraction()
    {
        return hasRendered
            && !IsDisabled
            && !string.IsNullOrEmpty(GetHoverRootId())
            && Element.HasValue;
    }

    private string? GetHoverRootId()
    {
        return RootContext?.RootId ?? Handle?.RootId;
    }

    private async Task InitializeHoverInteractionAsync(string? interactionTriggerId = null)
    {
        var rootId = GetHoverRootId();
        var id = interactionTriggerId ?? triggerId;
        var element = Element;
        if (string.IsNullOrEmpty(rootId) || !element.HasValue || string.IsNullOrEmpty(id))
        {
            return;
        }

        try
        {
            var module = await ModuleTask.Value;
            var effectiveDelay = GetEffectiveDelay();
            var effectiveCloseDelay = GetEffectiveCloseDelay();
            var disableHoverablePopup = ResolveDisableHoverablePopup();
            await module.InvokeVoidAsync("initializeHoverInteraction", rootId, id, element.Value, effectiveDelay, effectiveCloseDelay, disableHoverablePopup);
            hoverInitialized = true;
            hoverRootId = rootId;
            lastEffectiveDelay = effectiveDelay;
            lastEffectiveCloseDelay = effectiveCloseDelay;
            lastDisableHoverablePopup = disableHoverablePopup;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            _ = ex; // Expected during circuit disconnect - safe to ignore.
        }
    }

    private async Task DisposeHoverInteractionAsync(string? interactionTriggerId = null)
    {
        var id = interactionTriggerId ?? triggerId;
        var rootId = hoverRootId;
        if (!hoverInitialized ||
            !hasRendered ||
            moduleTask?.IsValueCreated != true ||
            string.IsNullOrEmpty(rootId) ||
            string.IsNullOrEmpty(id))
        {
            ResetHoverInteractionState();
            return;
        }

        try
        {
            var module = await moduleTask.Value;
            await module.InvokeVoidAsync("disposeHoverInteraction", rootId, id);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            _ = ex; // Expected during circuit disconnect - safe to ignore.
        }

        ResetHoverInteractionState();
    }

    private void QueueHoverRebind(string previousTriggerId, string desiredTriggerId)
    {
        var previousTask = hoverRebindTask;
        hoverRebindTask = RebindHoverInteractionAsync(previousTask, previousTriggerId, desiredTriggerId);
    }

    private void QueueHoverReinitialize()
    {
        var previousTask = hoverRebindTask;
        hoverRebindTask = ReinitializeHoverInteractionAsync(previousTask);
    }

    private async Task ReinitializeHoverInteractionAsync(Task previousTask)
    {
        try
        {
            await previousTask;
            await DisposeHoverInteractionAsync();

            if (CanInitializeHoverInteraction())
            {
                await InitializeHoverInteractionAsync();
            }
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private async Task RebindHoverInteractionAsync(Task previousTask, string previousTriggerId, string desiredTriggerId)
    {
        try
        {
            await previousTask;
            await DisposeHoverInteractionAsync(previousTriggerId);

            if (CanInitializeHoverInteraction())
            {
                await InitializeHoverInteractionAsync(desiredTriggerId);
            }
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    }

    private void ResetHoverInteractionState()
    {
        hoverInitialized = false;
        hoverRootId = null;
        lastEffectiveDelay = -1;
        lastEffectiveCloseDelay = -1;
        lastDisableHoverablePopup = null;
    }

    private bool ResolveDisableHoverablePopup()
    {
        var rootContext = RootContext;
        if (rootContext is not null)
        {
            return rootContext.DisableHoverablePopup || rootContext.TrackCursorAxis == TrackCursorAxis.Both;
        }

        return Handle?.DisableHoverablePopup ?? false;
    }

    private async Task UpdateHoverInteractionDelaysAsync()
    {
        var rootId = GetHoverRootId();
        if (!hoverInitialized || string.IsNullOrEmpty(rootId))
        {
            return;
        }

        var effectiveDelay = GetEffectiveDelay();
        var effectiveCloseDelay = GetEffectiveCloseDelay();
        if (effectiveDelay == lastEffectiveDelay && effectiveCloseDelay == lastEffectiveCloseDelay)
        {
            return;
        }

        try
        {
            var module = await ModuleTask.Value;
            await module.InvokeVoidAsync("updateHoverInteractionDelays", rootId, triggerId, effectiveDelay, effectiveCloseDelay);
            lastEffectiveDelay = effectiveDelay;
            lastEffectiveCloseDelay = effectiveCloseDelay;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            _ = ex; // Expected during circuit disconnect - safe to ignore.
        }
    }

    private Task RequestOpenAsync(bool open, TooltipOpenChangeReason reason)
    {
        if (HasHandle)
        {
            if (open)
            {
                Handle!.RequestOpen(triggerId, reason);
            }
            else
            {
                Handle!.RequestClose(reason);
            }
            return Task.CompletedTask;
        }

        if (RootContext is not null)
        {
            return RootContext.SetOpenAsync(open, reason, triggerId);
        }

        return Task.CompletedTask;
    }

    private bool IsAnyTooltipOpen()
    {
        if (HasHandle)
        {
            return Handle!.IsOpen;
        }

        return RootContext?.GetOpen() == true;
    }
}
