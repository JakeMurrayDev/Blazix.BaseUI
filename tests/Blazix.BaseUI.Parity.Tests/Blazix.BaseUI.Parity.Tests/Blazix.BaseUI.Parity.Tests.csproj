<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- slopwatch-ignore: SW005 CS7022: Web SDK test project with GenerateProgramFile=false has duplicate entry point. xUnit1051: test helper methods on public test classes are not test methods. -->
    <NoWarn>CS7022;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Blazix.BaseUI\Blazix.BaseUI.csproj" />
    <ProjectReference Include="..\Blazix.BaseUI.Parity.Tests.Client\Blazix.BaseUI.Parity.Tests.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" Version="1.57.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <!-- System.Drawing decodes PNG on Windows only, so the pixel comparator decodes with
         Skia. The native assets package is per-platform: this one covers macOS, and a
         Linux or Windows run needs SkiaSharp.NativeAssets.Linux (Windows binaries ship
         inside the SkiaSharp package itself). -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\shared\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="shared" />
    <None Include="..\manifest\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="manifest" />
    <None Include="..\waivers\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="waivers" />
    <None Include="..\react-fixtures\dist\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="react-dist" />
    <None Include="Report\report.css" CopyToOutputDirectory="PreserveNewest" LinkBase="Report" />
  </ItemGroup>

</Project>
