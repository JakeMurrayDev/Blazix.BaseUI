@using Blazix.BaseUI.Progress

<ProgressRoot Value="20" class="grid max-w-full w-60 grid-cols-2 gap-y-2">
    <ProgressLabel class="text-sm font-normal text-neutral-950 dark:text-white">Export data</ProgressLabel>
    <ProgressValue class="text-right text-sm text-neutral-950 dark:text-white" />
    <ProgressTrack class="col-span-2 h-1 overflow-hidden bg-neutral-200 dark:bg-neutral-800">
        <ProgressIndicator class="bg-neutral-950 transition-[width] duration-500 dark:bg-white" />
    </ProgressTrack>
</ProgressRoot>
