@using Blazix.BaseUI.Meter

<MeterRoot Value="24" class="grid max-w-full w-60 grid-cols-2 gap-y-2">
    <MeterLabel class="text-sm font-normal text-neutral-950 dark:text-white">Storage Used</MeterLabel>
    <MeterValue class="text-right text-sm text-neutral-950 dark:text-white" />
    <MeterTrack class="col-span-2 h-3 overflow-hidden bg-neutral-200 dark:bg-neutral-800">
        <MeterIndicator class="bg-neutral-950 transition-[width] duration-500 dark:bg-white" />
    </MeterTrack>
</MeterRoot>
