@page "/fixture/{Component}/{Demo}/wasm"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<FixtureHostBody Component="@Component" Demo="@Demo" />

@code {
    /// <summary>Gets or sets the component segment of the fixture id.</summary>
    [Parameter] public string Component { get; set; } = string.Empty;

    /// <summary>Gets or sets the demo segment of the fixture id.</summary>
    [Parameter] public string Demo { get; set; } = string.Empty;
}
