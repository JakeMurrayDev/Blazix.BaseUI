{
  "name": "blazix-parity-react-fixtures",
  "private": true,
  "type": "module",
  "scripts": {
    "parity:css": "node scripts/resolve-base-ui-source.mjs && tailwindcss -i src/parity.css -o ../Blazix.BaseUI.Parity.Tests/wwwroot/parity.css",
    "parity:report-css": "node scripts/build-report-css.mjs",
    "parity:report-css:check": "node scripts/build-report-css.mjs --check",
    "parity:build": "node scripts/resolve-base-ui-source.mjs && vite build && node scripts/write-provenance-manifest.mjs",
    "parity:baseline": "pnpm parity:build && dotnet run --project ../Blazix.BaseUI.Parity.Tests/Blazix.BaseUI.Parity.Tests.csproj -- --write-baselines",
    "parity:dev": "vite"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.4",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
